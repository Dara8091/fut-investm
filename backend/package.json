{
  "name": "fut-invest-backend",
  "version": "2.0.0",
  "description": "Backend API para fut.invest - Panel de Inversión Institucional",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "test:e2e": "jest --runInBand --forceExit --testPathPattern='e2e-critical'",
    "test:admin": "jest --runInBand --testPathPattern='admin|waf|settings'",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix --audit-level=high",
    "lint": "eslint src/ --ext .js",
    "certs": "powershell -File scripts/generate-certs.ps1",
    "secrets": "node scripts/generate-secrets.js",
    "backup": "node scripts/backup.js",
    "pre-deploy": "node scripts/pre-deploy-checklist.js",
    "logs:error": "tail -f logs/error.log",
    "logs:all": "tail -f logs/combined.log"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "src/__tests__"
    ],
    "verbose": true,
    "forceExit": true,
    "detectOpenHandles": true
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.8",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}

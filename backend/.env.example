# ============================================
# fut.invest - Backend Environment Variables
# ============================================
# Copia este archivo a .env y configura tus valores
# NUNCA commitees .env con valores reales

# ============================================
# SERVER
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# CORS - Origen del frontend
# ============================================
FRONTEND_URL=http://localhost:8000

# ============================================
# JWT - Generar con: openssl rand -base64 48
# ============================================
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_EXPIRY=15m

# ============================================
# APP SECURITY
# ============================================
TOTP_SECRET=change_me_in_production
APP_SECRET=change_me_in_production

# ============================================
# DATABASE
# ============================================
# Opciones: sqlite, postgres
DB_TYPE=sqlite
DB_PATH=./data/fut_invest.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/futinvest

# ============================================
# WALLET LIMITS
# ============================================
MAX_WITHDRAWAL_PER_DAY=50000
MIN_WITHDRAWAL=10

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# WITHDRAWAL WORKER
# ============================================
WITHDRAWAL_WORKER_ENABLED=true
WITHDRAWAL_BATCH_SIZE=10
WITHDRAWAL_POLL_INTERVAL_MS=30000

# ============================================
# EMAIL (SMTP) - Descomentar para producción
# ============================================
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_SECURE=false
# EMAIL_FROM=noreply@futinvest.io

# ============================================
# NOTIFICATIONS
# ============================================
NOTIFICATION_LOG_SIZE=100

# ============================================
# METRICS & ANALYTICS
# ============================================
METRICS_ENABLED=true

# ============================================
# SECURITY (WAF)
# ============================================
WAF_ENABLED=true
WAF_BLOCK_VPN=false
# BLOCKED_COUNTRIES=RU,CN,KP,IR,SY,CU,VE
# BLOCKED_IPS=

# ============================================
# CAPTCHA
# ============================================
CAPTCHA_ENABLED=false
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# ============================================
# REFERRAL SYSTEM
# ============================================
REFERRAL_BONUS_RATE=0.05

# ============================================
# CACHE
# ============================================
CACHE_TTL=60
# REDIS_URL=redis://localhost:6379

# ============================================
# PAYMENT PROVIDER
# ============================================
PAYMENT_PROVIDER=payka
PAYKA_ENABLED=true

# ============================================
# MASTER WALLETS - Direcciones reales
# ============================================
MASTER_WALLET_BTC=
MASTER_WALLET_USDT_TRC20=
MASTER_WALLET_USDT_ERC20=
MASTER_WALLET_ETH=
MASTER_WALLET_SOL=
MASTER_WALLET_BNB=
MASTER_WALLET_LTC=

# ============================================
# PASSWORD RESET
# ============================================
RESET_TOKEN_HOURS=1

# ============================================
# EMAIL VERIFICATION
# ============================================
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# SENTRY (Error Tracking)
# ============================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ============================================
# SUPABASE (Opcional)
# ============================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# HASHICORP VAULT (Opcional)
# ============================================
# VAULT_ADDR=https://vault.futinvest.io:8200
# VAULT_TOKEN=hvs.your_vault_token
# VAULT_SECRET_PATH=secret/data/futinvest

# ============================================
# WEB PUSH (VAPID)
# ============================================
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@futinvest.io

# ============================================
# ANALYTICS (Plausible)
# ============================================
# ANALYTICS_DOMAIN=futinvest.io
# ANALYTICS_HOST=https://plausible.io

# ============================================
# FUTINVEST - Motor de Arbitraje
# ============================================
FUTINVEST_ENABLED=true
FUTINVEST_AUTO_EXECUTE=false
FUTINVEST_MIN_PROFIT_USD=1.0
FUTINVEST_MAX_TRADE_USD=10000
FUTINVEST_PLATFORM_FEE_PERCENT=10
FUTINVEST_SCAN_INTERVAL_MS=10000
FUTINVEST_SUPPORTED_EXCHANGES=binance,okx,bybit,kucoin,gate
FUTINVEST_SUPPORTED_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,LTC/USDT

# FutInvest - Perfil de Usuario
FUTINVEST_PROFILE_SHOW_STATS=true
FUTINVEST_PROFILE_SHOW_HISTORY=true
FUTINVEST_PROFILE_SHOW_CONFIG=true
FUTINVEST_PROFILE_MAX_HISTORY=50
FUTINVEST_PROFILE_DEFAULT_MIN_PROFIT=1.0
FUTINVEST_PROFILE_DEFAULT_MAX_TRADE=10000
FUTINVEST_PROFILE_AUTO_SCAN_INTERVAL=30

# ============================================
# PYTHON SERVICES (Opcional)
# ============================================
PYTHON_SERVICES_ENABLED=true
PYTHON_SERVICES_URL=http://localhost:3002

# ============================================
# CSRF (Producción)
# ============================================
CSRF_ENABLED=true
